# ============================================================
# Agent IA Factures Fournisseurs — Variables d'environnement
# ------------------------------------------------------------
# Copier ce fichier en `.env` et renseigner les valeurs.
# NE JAMAIS committer `.env` (il est dans .gitignore).
# NE JAMAIS mettre une clé réelle dans ce fichier d'exemple.
# ============================================================

# Clé API Axonaut (Axonaut > Paramètres > API — header HTTP `userApiKey`)
AXONAUT_API_KEY=

# Clé API Anthropic (analyse documentaire Claude)
ANTHROPIC_API_KEY=

# Clé API OpenAI (alternative / secours pour l'analyse documentaire)
OPENAI_API_KEY=

# ID du dossier racine Google Drive "FACTURES FOURNISSEURS"
GOOGLE_DRIVE_FOLDER_ID=

# URL du webhook Make (si un scénario secondaire est déclenché par webhook)
MAKE_WEBHOOK_URL=

# Chaîne de connexion base de contrôle / journal (Supabase ou PostgreSQL)
# Exemple de format (sans identifiants réels) : postgresql://user:password@host:5432/dbname
DATABASE_URL=
