# --- Claude (lecture des étiquettes) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modèles (facultatif) : rapide pour la 1re passe et le contrôle, précis pour la relecture
CLAUDE_MODEL_FAST=claude-sonnet-5-5
CLAUDE_MODEL_PRECISE=claude-opus-5-5

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=ma-boutique.myshopify.com
SHOPIFY_API_VERSION=2026-10
# Option A : app créée dans le Dev Dashboard (recommandé) → Client ID + Client secret
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B : token d'une app personnalisée existante (shpat_…). Si renseigné, il a priorité.
SHOPIFY_ADMIN_TOKEN=

# --- Accès tablette ---
APP_PIN=123456
# 32 caractères aléatoires, ex. : openssl rand -hex 32
SESSION_SECRET=
