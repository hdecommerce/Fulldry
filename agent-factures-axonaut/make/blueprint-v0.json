{
  "name": "FACTURES-HD-V0",
  "flow": [
    {
      "id": 1,
      "module": "google-email:TriggerNewEmail",
      "version": 2,
      "parameters": {
        "account": null,
        "folder": "INBOX",
        "criteria": "CUSTOM",
        "query": "label:FACTURES-AXONAUT has:attachment",
        "markSeen": false,
        "maxResults": 5
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "notes": "Surveille le libellé FACTURES AXONAUT. Activer la récupération des pièces jointes."
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{1.attachments}}"
      },
      "metadata": {
        "designer": { "x": 300, "y": 0 },
        "notes": "Iterator des pièces jointes."
      }
    },
    {
      "id": 3,
      "module": "util:SetVariable2",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Piece jointe exploitable",
        "conditions": [
          [
            { "a": "{{2.mimeType}}", "o": "text:equal", "b": "application/pdf" },
            { "a": "{{2.size}}", "o": "number:greaterorequal", "b": "15000" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "logo" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "signature" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "image00" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "smime" }
          ],
          [
            { "a": "{{2.mimeType}}", "o": "text:equal", "b": "image/jpeg" },
            { "a": "{{2.size}}", "o": "number:greaterorequal", "b": "15000" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "logo" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "signature" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "image00" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "smime" }
          ],
          [
            { "a": "{{2.mimeType}}", "o": "text:equal", "b": "image/png" },
            { "a": "{{2.size}}", "o": "number:greaterorequal", "b": "15000" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "logo" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "signature" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "image00" },
            { "a": "{{lower(2.fileName)}}", "o": "text:notcontain", "b": "smime" }
          ]
        ]
      },
      "mapper": {
        "name": "file_sha256",
        "scope": "roundtrip",
        "value": "{{sha256(2.data)}}"
      },
      "metadata": {
        "designer": { "x": 600, "y": 0 },
        "notes": "Empreinte SHA-256 du fichier (cle anti-doublon V0)."
      }
    },
    {
      "id": 4,
      "module": "google-drive:uploadAFile",
      "version": 1,
      "parameters": {
        "account": null
      },
      "mapper": {
        "folderId": "REMPLACER_PAR_ID_DOSSIER_00_ARCHIVES_ORIGINALES",
        "title": "{{formatDate(now; \"YYYY-MM-DD_HHmmss\")}}_{{2.fileName}}",
        "data": "{{2.data}}"
      },
      "metadata": {
        "designer": { "x": 900, "y": 0 },
        "notes": "Archivage de l'original AVANT tout envoi. Selectionner le dossier 00_ARCHIVES_ORIGINALES."
      }
    },
    {
      "id": 5,
      "module": "datastore:ActionExistRecord",
      "version": 1,
      "parameters": {
        "datastore": "hd_ecommerce_invoice_registry"
      },
      "mapper": {
        "key": "{{3.file_sha256}}"
      },
      "metadata": {
        "designer": { "x": 1200, "y": 0 },
        "notes": "Le fichier a-t-il deja ete traite ?"
      }
    },
    {
      "id": 6,
      "module": "builtin:BasicRouter",
      "version": 1,
      "parameters": {},
      "mapper": null,
      "metadata": { "designer": { "x": 1500, "y": 0 } },
      "routes": [
        {
          "flow": [
            {
              "id": 7,
              "module": "google-email:ActionModifyEmailLabels",
              "version": 1,
              "parameters": { "account": null },
              "filter": {
                "name": "DOUBLON",
                "conditions": [
                  [ { "a": "{{5.exists}}", "o": "boolean:equal", "b": "true" } ]
                ]
              },
              "mapper": {
                "emailId": "{{1.id}}",
                "addLabels": [ "FACTURES AXONAUT/DOUBLONS" ],
                "removeLabels": [ "FACTURES AXONAUT" ]
              },
              "metadata": {
                "designer": { "x": 1800, "y": -150 },
                "notes": "Doublon : aucun envoi a Axonaut. Selectionner les libelles dans les listes."
              }
            },
            {
              "id": 8,
              "module": "google-email:ActionSendEmail",
              "version": 2,
              "parameters": { "account": null },
              "mapper": {
                "to": [ "hdecommerce63@gmail.com" ],
                "subject": "[FACTURES][DOUBLON] {{2.fileName}}",
                "contentType": "text",
                "text": "Doublon detecte : {{2.fileName}} a deja ete envoye a Axonaut le {{5.record.sent_at}}. Aucun nouvel envoi effectue. Email d'origine : {{1.subject}}."
              },
              "metadata": {
                "designer": { "x": 2100, "y": -150 },
                "notes": "Alerte doublon (a vous-meme)."
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 9,
              "module": "datastore:ActionAddRecord",
              "version": 1,
              "parameters": {
                "datastore": "hd_ecommerce_invoice_registry",
                "overwrite": true
              },
              "filter": {
                "name": "ENVOI (pas un doublon)",
                "conditions": [
                  [ { "a": "{{5.exists}}", "o": "boolean:equal", "b": "false" } ]
                ]
              },
              "mapper": {
                "key": "{{3.file_sha256}}",
                "data": {
                  "status": "sending",
                  "original_filename": "{{2.fileName}}",
                  "gmail_message_id": "{{1.id}}",
                  "drive_original_url": "{{4.webViewLink}}",
                  "created_at": "{{now}}"
                }
              },
              "metadata": {
                "designer": { "x": 1800, "y": 150 },
                "notes": "Verrou ecrit AVANT l'envoi : un plantage ne peut jamais provoquer un double envoi."
              }
            },
            {
              "id": 10,
              "module": "google-email:ActionSendEmail",
              "version": 2,
              "parameters": { "account": null },
              "mapper": {
                "to": [ "expense@axonaut.com" ],
                "subject": "Facture fournisseur - {{2.fileName}}",
                "contentType": "text",
                "text": "Facture fournisseur HD ECOMMERCE transmise pour traitement. Validation requise dans Axonaut.",
                "attachments": [
                  { "fileName": "{{2.fileName}}", "data": "{{2.data}}" }
                ]
              },
              "metadata": {
                "designer": { "x": 2100, "y": 150 },
                "notes": "SEUL point de sortie vers Axonaut."
              }
            },
            {
              "id": 11,
              "module": "datastore:ActionAddRecord",
              "version": 1,
              "parameters": {
                "datastore": "hd_ecommerce_invoice_registry",
                "overwrite": true
              },
              "mapper": {
                "key": "{{3.file_sha256}}",
                "data": {
                  "status": "sent_to_axonaut",
                  "original_filename": "{{2.fileName}}",
                  "gmail_message_id": "{{1.id}}",
                  "drive_original_url": "{{4.webViewLink}}",
                  "created_at": "{{9.created_at}}",
                  "sent_at": "{{now}}"
                }
              },
              "metadata": {
                "designer": { "x": 2400, "y": 150 },
                "notes": "Confirmation de l'envoi."
              }
            },
            {
              "id": 12,
              "module": "google-email:ActionModifyEmailLabels",
              "version": 1,
              "parameters": { "account": null },
              "mapper": {
                "emailId": "{{1.id}}",
                "addLabels": [ "FACTURES AXONAUT/ENVOYEES" ],
                "removeLabels": [ "FACTURES AXONAUT" ]
              },
              "metadata": {
                "designer": { "x": 2700, "y": 150 },
                "notes": "L'email passe dans le sous-dossier ENVOYEES."
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "confidential": false,
      "dataloss": false,
      "dlq": false
    },
    "designer": { "orphans": [] }
  }
}
